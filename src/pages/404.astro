---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../../site.config.mjs';
---
<Layout title="找不到頁面｜閱見" description="找不到這個頁面。你可以返回閱見首頁。" notFound><section class="not-found wrap"><p class="eyebrow">404／找不到頁面</p><h1>這一頁<br /><em>找不到了</em></h1><p>回首頁繼續探索閱見。</p><a class="button" href={site.base}>返回閱見首頁 <Icon name="arrow" /></a></section></Layout>
