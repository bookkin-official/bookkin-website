---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { site } from "../../site.config.mjs";
import { translations } from "../content/home";
const copy = translations.en;
---

<Layout title="Page not found · Bookkin" notFound
  ><section class="not-found wrap">
    <p>404</p><h1>{copy.notFound}</h1><a class="text-link" href={site.base}
      >{copy.home}<Icon name="arrow" /></a>
  </section></Layout
>
