---
import Layout from "../layouts/Layout.astro";
import Icon from "./Icon.astro";
import { site, settings } from "../../site.config.mjs";
import { translations, type Locale } from "../content/home";
import {
  documents,
  type DocumentKey,
  type SectionCopy,
} from "../content/documents";

interface Props {
  document: DocumentKey;
  locale: Locale;
  autoLocale?: boolean;
}
const { document, locale, autoLocale = false } = Astro.props;
const page = documents[document];
const edition = page.locales[locale];
const copy = translations[locale].documents;
const sections = Object.entries(edition.sections) as [string, SectionCopy][];
// Both targets stay on the app origin: the sign-in action needs the web app,
// and the server only accepts the receipt checker from there.
const onApp = (relative: string) =>
  settings.WEB_APP_URL ? new URL(relative, settings.WEB_APP_URL).href : "";
const action = page.action ? onApp(`?account_action=${page.action}`) : "";
const checker = page.action === "delete" ? onApp("legal/deletion.html") : "";
const contact = `${edition.contact} · <!--email_off--><a href="mailto:bookkin.official@gmail.com">bookkin.official@gmail.com</a><!--/email_off-->`;
---

<Layout
  locale={locale}
  autoLocale={autoLocale}
  path={`${document}/`}
  title={`${edition.title} · Bookkin`}
  description={edition.summary}
>
  <article class="document wrap" aria-labelledby="document-title">
    <header class="document-header">
      <p class="eyebrow">{page.action ? copy.support : copy.legal}</p>
      <h1 id="document-title">{edition.title}</h1>
      <p class="document-summary">{edition.summary}</p>
      <p class="document-meta">
        <span>{copy.operator}</span>
        <span
          >{copy.updated}{" "}
          <time datetime={page.date}>{edition.updated}</time></span
        >
        <span set:html={contact} />
      </p>
    </header>
    <div class="document-body">
      <nav class="document-toc" aria-labelledby="document-contents">
        <h2 id="document-contents">{copy.contents}</h2>
        <ol>
          {
            sections.map(([id, section]) => (
              <li>
                <a href={`#${id}`}>{section.heading}</a>
              </li>
            ))
          }
        </ol>
      </nav>
      {/* Narrow screens fold the same links into a native disclosure. */}
      <details class="document-toc-menu">
        <summary>{copy.contents}<Icon name="plus" size={20} /></summary>
        <ol>
          {
            sections.map(([id, section]) => (
              <li>
                <a href={`#${id}`}>{section.heading}</a>
              </li>
            ))
          }
        </ol>
      </details>
      <div class="document-content">
        {
          action && (
            <a class="document-action" href={action}>
              {page.action === "delete" ? copy.openDeletion : copy.openSupport}
              <Icon name="arrow" size={16} />
            </a>
          )
        }
        {
          sections.map(([id, section]) => (
            <section id={id} aria-labelledby={`document-${id}`}>
              <h2 id={`document-${id}`}>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </section>
          ))
        }
        {
          checker && (
            <aside class="document-note" aria-labelledby="document-note">
              <h2 id="document-note">{copy.checkTitle}</h2>
              <p>{copy.checkText}</p>
              <a class="text-link" href={checker}>
                {copy.checkLink}
                <Icon name="arrow" size={16} />
              </a>
            </aside>
          )
        }
        <nav class="document-related" aria-labelledby="document-related">
          <h2 id="document-related">{copy.related}</h2>
          <ul>
            {
              page.related.map((key) => (
                <li>
                  <a href={site.asset(`${locale}/${key}/`)}>
                    {documents[key].locales[locale].title}
                    <Icon name="arrow" size={16} />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </article>
</Layout>
