---
import { site, settings } from '../../site.config.mjs';
import { copy } from '../content/home';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/newsreader/latin-400-italic.css';
import sansFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import serifFont from '@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url';
import italicFont from '@fontsource/newsreader/files/newsreader-latin-400-italic.woff2?url';
interface Props { title?: string; description?: string; notFound?: boolean; }
const { title = copy.title, description = copy.description, notFound = false } = Astro.props;
const legalLinks = [['聯絡我們', settings.CONTACT_URL], ['私隱政策', settings.PRIVACY_URL], ['使用條款', settings.TERMS_URL]].filter(([, url]) => url);
---
<!doctype html>
<html lang="zh-Hant-HK">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {[sansFont,serifFont,italicFont].map(font=><link rel="preload" href={font} as="font" type="font/woff2" crossorigin="anonymous" />)}
    <meta name="theme-color" content="#eff2f7" />
    <meta name="description" content={description} />
    {notFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={site.siteUrl} />}
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bookkin" />
    <meta property="og:locale" content="zh_HK" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={notFound ? site.absolute('404.html') : site.siteUrl} />
    <meta property="og:image" content={site.absolute('og.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bookkin. Your books. Your kind of people. A quiet social library." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={site.absolute('og.png')} />
    <link rel="icon" type="image/png" href={site.asset('favicon.png')} />
    <link rel="apple-touch-icon" href={site.asset('bookkin-icon.png')} />
    <link rel="sitemap" href={site.absolute('sitemap-index.xml')} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳至主要內容</a>
    <header class="site-header">
      <div class="nav-wrap">
        <a class="brand" href={site.base} aria-label="閱見首頁"><img src={site.asset('bookkin-icon.png')} width="34" height="34" alt="" /><span>Bookkin<span class="brand-dot">.</span></span></a>
        <div class="navigation-cluster"><nav aria-label="主選單">
          <a class="nav-secondary" data-nav-section="features" href={`${site.base}#features`}>功能介紹</a>
          <a class="nav-secondary" data-nav-section="how-it-works" href={`${site.base}#how-it-works`}>開始使用</a>
          <a class="nav-download" data-nav-section="download" href={`${site.base}#download`}>下載 <Icon name="down" size={17} /></a>
        </nav>
        <details class="mobile-menu"><summary aria-label="網站選單"><span class="menu-glyph" aria-hidden="true"><span></span><span></span></span></summary><nav aria-label="手機版選單"><a href={`${site.base}#features`}>功能介紹 <Icon name="arrow" size={18} /></a><a href={`${site.base}#how-it-works`}>開始使用 <Icon name="arrow" size={18} /></a><a href={`${site.base}#faq`}>常見問題 <Icon name="arrow" size={18} /></a></nav></details>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap">
      <p>© {new Date().getUTCFullYear()} Bookkin</p>
      <nav aria-label="頁尾選單">
        {legalLinks.map(([label, url]) => <a href={url}>{label}</a>)}
        <a href="#main">返回頂部 ↑</a>
      </nav>
    </footer>
    {site.origin === 'https://web.bookkin.net' && (
      <script is:inline src="https://app.johncrm.com/widget/chat.js" data-site-key="wc_a0f0d643761440c7e62842b5" async></script>
    )}
  </body>
</html>
